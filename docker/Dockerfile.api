# VaultForge API - Multi-stage Docker Build
# Stage 1: Build
FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /app

# Cache dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY services/api/ ./services/api/

# Build with optimizations + security flags
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags="-w -s -X main.version=$(cat VERSION 2>/dev/null || echo dev)" \
    -o /vaultforge-api ./services/api/

# Stage 2: Security scan (optional, runs before runtime)
FROM builder AS scanner
RUN apk add --no-cache curl
# Placeholder: add Trivy/Snyk scan here in CI

# Stage 3: Runtime (distroless-inspired minimal image)
FROM gcr.io/distroless/static-debian12:nonroot AS runtime

# Labels for image metadata
LABEL org.opencontainers.image.title="vaultforge-api" \
      org.opencontainers.image.description="VaultForge institutional treasury API" \
      org.opencontainers.image.vendor="VaultForge" \
      org.opencontainers.image.source="https://github.com/vaultforge/vaultforge"

# Copy CA certs for HTTPS
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# Copy timezone data
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo

# Copy binary
COPY --from=builder /vaultforge-api /vaultforge-api

# Copy VERSION file for /v1/version endpoint
COPY VERSION /app/VERSION

# Run as nonroot user (uid 65532 in distroless)
USER nonroot:nonroot

EXPOSE 8080

# Health check using distroless-compatible approach
# Note: distroless doesn't have wget/curl, health check is handled by orchestrator
# For Docker standalone, use: docker run --health-cmd '...' 
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD ["/vaultforge-api", "--version"]

ENTRYPOINT ["/vaultforge-api"]
