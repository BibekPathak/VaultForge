# VaultForge API - Multi-stage Docker Build
# Stage 1: Build
FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /app

# Cache dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY services/api/ ./services/api/

# Build with optimizations
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-w -s" -o /vaultforge-api ./services/api/

# Stage 2: Runtime
FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata

# Non-root user
RUN addgroup -g 1001 vaultforge && \
    adduser -D -u 1001 -G vaultforge vaultforge

WORKDIR /app

COPY --from=builder /vaultforge-api .

RUN chown -R vaultforge:vaultforge /app

USER vaultforge

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:8080/health || exit 1

ENTRYPOINT ["/app/vaultforge-api"]
