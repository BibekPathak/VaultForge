# VaultForge API - Environment Configuration
# Copy to .env and fill in values for your deployment

# ── Server ────────────────────────────────────────────
PORT=8080
VAULTFORGE_ENV=development          # development | staging | production
LOG_LEVEL=info                      # debug | info | warn | error

# ── Database ──────────────────────────────────────────
DATABASE_URL=host=localhost user=vaultforge password=vaultforge dbname=vaultforge port=5432 sslmode=disable

# ── Solana ────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_WS_URL=wss://api.devnet.solana.com

# ── Authentication ────────────────────────────────────
# Required in production (min 32 characters)
# JWT_SECRET=change-me-in-production-minimum-32-characters

# ── CORS ──────────────────────────────────────────────
# Comma-separated origins, or * for all (not recommended in production)
CORS_ORIGINS=*

# ── Timeouts ──────────────────────────────────────────
READ_TIMEOUT=15s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

# ── Request Limits ────────────────────────────────────
MAX_BODY_BYTES=10485760             # 10 MB

# ── Rate Limiting ─────────────────────────────────────
# RATE_LIMIT_RPS=100                 # requests per second per tenant
# RATE_LIMIT_BURST=200               # burst capacity
